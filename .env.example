# GConnect daemon configuration (copy to .env and adjust).
# All variables use the CONNECT_ prefix and are read from the environment
# or a .env file in the repository root (host-daemon mode).

# --- Network -----------------------------------------------------------
# Bind host. Default is loopback-only for security.
# CONNECT_HOST=127.0.0.1

# Set to true to expose the daemon on the LAN (0.0.0.0 unless CONNECT_HOST
# is set). Requires a strong CONNECT_AUTH_TOKEN.
# CONNECT_ALLOW_LAN=false

# Web IDE / daemon port.
# CONNECT_PORT=8000

# Container port forwarded for voice inference streaming (8001:8001).
# CONNECT_INFERENCE_PORT=8001

# --- Authentication ------------------------------------------------------
# Shared secret required by every /api/* and /ws/* endpoint.
# Leave empty in desktop/loopback mode: a strong token is auto-generated and
# persisted to .gconnect/auth_token (the desktop app reads it automatically).
# REQUIRED (set explicitly) when CONNECT_ALLOW_LAN=true.
# CONNECT_AUTH_TOKEN=

# --- Workspace -----------------------------------------------------------
# Directory mounted into the container at /workspace.
# (The desktop app overrides this to its app-data workspace automatically.)
# CONNECT_WORKSPACE_DIR=./workspace

# --- Docker sandbox ------------------------------------------------------
# CONNECT_CONTAINER_NAME=connect_dev_sandbox
# CONNECT_CONTAINER_IMAGE=pytorch/pytorch:latest
# CONNECT_SHM_SIZE=8g

# Keep downloaded models inside the container's temporary layer (Colab style)
# instead of persisting them under workspace/.hf_cache.
# CONNECT_EPHEMERAL_MODE=false

# --- Dangerous / dev-only ------------------------------------------------
# Runs a HOST shell (cmd.exe / bash) in the terminal when Docker is down.
# Off by default: it bypasses container isolation entirely.
# CONNECT_ALLOW_LOCAL_FALLBACK=false

# Disables token auth (loopback dev only; ignored when CONNECT_ALLOW_LAN=true).
# CONNECT_AUTH_DISABLED=false
